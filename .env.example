# ================================
# E-Library System Environment Variables
# Template only: copy to `.env` for local use.
# Set production values in Render instead of committing them here.
# ================================

# Database
# Use either DB_URL/DATABASE_URL or DB_HOST/DB_PORT/DB_NAME.
DB_URL=jdbc:postgresql://localhost:5432/elibrary
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elibrary
DB_USER=elibrary
DB_PASSWORD=change_me
DB_SSL_MODE=disable

# Local app ports
# Docker maps the frontend to 3000. Standalone Vite dev uses 5173.
BACKEND_PORT=8080
FRONTEND_PORT=3000

# App URLs
# Use 3000 for Docker Compose. Use 5173 if you run the frontend with `npm run dev`.
FRONTEND_APP_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Spring profile
SPRING_PROFILES_ACTIVE=docker

# Frontend API/auth settings for local Docker or local dev
VITE_API_URL=/api
VITE_AUTH_BASE_URL=http://localhost:8080
BACKEND_UPSTREAM=http://backend:8080

# OAuth
# Leave blank in the example. Fill these in locally or in Render.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Render notes
# Backend:
# FRONTEND_APP_URL=https://<your-frontend>.onrender.com
# APP_CORS_ALLOWED_ORIGINS=https://<your-frontend>.onrender.com
#
# Frontend:
# VITE_API_URL=https://<your-backend>.onrender.com/api
# VITE_AUTH_BASE_URL=https://<your-backend>.onrender.com
